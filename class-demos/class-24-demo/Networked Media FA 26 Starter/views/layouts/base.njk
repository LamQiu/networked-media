{# this used to be home.njk #}
{# i have made it a layout template #}
<html>
  <head>
    {# it is a placeholder to inject some html depending on the page #}
    <title>{% block title %}{% endblock %}</title>
    <link rel="stylesheet" href="style.css" />
    {% block extrastylesheet %} {% endblock %}
  </head>
  <body>
    <section></section>
    <main>
      <nav>
        Page Visits: {{ serverData }}
        <div class="links">
          <a href="/">home</a>
          <a href="/about">about</a>
          <div>
            <a href="/login">login</a> /
            <a href="/signup">signup</a>
          </div>
        </div>
      </nav>
      {% block content %} {% endblock %}

    </main>
    <section></section>
  </body>
</html>
